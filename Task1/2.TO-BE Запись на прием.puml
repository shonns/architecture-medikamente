@startuml
title DFD: Процесс записи на прием



rectangle "API Шлюз" as gateway
rectangle "Keycloak (IAM)" as keycloak
actor "Пациент" as patient
actor "Ресепшен" as reception

rectangle "1. Запись на приём" as P1 {
  process P1_proc as "Обработка записи"
  database P1_store as "БД записей на прием (шифрование, RBAC)"
}

rectangle "2. Уведомления для пациента" as P2 {
  process P2_proc as "Отправка уведомлений"
}

' Потоки данных
patient -> reception :  Звонок на ресепшн

gateway -[#purple]-> keycloak: TLS 1.3
keycloak -[#purple]-> gateway: TLS 1.3
patient -[#purple]-> gateway: TLS 1.3
reception -[#purple]-> gateway: TLS 1.3

gateway -[#purple]-> P1_proc : Запрос через портал (TLS 1.3)
gateway -[#green]-> P1_proc : Запись/Корректировка записи  пациента (RBAC)
P1_proc -[#green]-> P1_store : Сохранение данных
P1_store -[#purple]-> P2_proc : Данные для уведомления (TLS 1.3)
P2_proc -[#purple]-> patient : SMS/email (TLS 1.3)
@enduml